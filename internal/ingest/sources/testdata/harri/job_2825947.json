 "code": "NEED_WORK_PERMIT"}]}, "notification_settings": {"users": []}, "assignees": [], "Compensation": [{"JobCompensation": {"job_id": 2825947, "compensation_from": 48000.0, "amount_label": "Up to", "Compensation": [{"id": 5, "code": "UP_TO", "name": "Up to"}], "CompensationRate": [{"id": 4, "code": "PER_YEAR", "name": "Year"}]}}]}, "brand": {"id": 4018609, "name": "Brindisa Tapas - Restaurants", "created": "Wed, 05 Feb 2020 15:04:35 GMT", "updated": "Fri, 10 Jul 2026 13:20:00 GMT", "group_id": 4018620, "hide_images": false, "slug": "BrindisaKitchensParent", "type": "enterprise", "external_business_name": "Brindisa Kitchens", "is_privacy_shield": true, "is_everify_enabled": false, "is_financial_unit": false, "follower": false, "instagram_url": "https://www.instagram.com/BrindisaKitchensspanishfoods/", "tiktok_url": "", "linkedin_url": "", "twitter_url": "https://twitter.com/BrindisaKitchens/", "youtube_url": "", "facebook_url": "https://www.facebook.com/BrindisaKitchens/", "description": "Brindisa Kitchens was founded in 2004 by Monika Linton, who along with her business partners was energised and inspired by the original Brindisa warehouse and shop that opened in 1988.\n\nMonika wanted to take the food to the next level and created the opportunity for tapas and cooking to become central to what we all now know as Brindisa Tapas. We all believe that exceptional ingredients create exceptional dishes, and this has become synonymous with Brindisa.\n\nWe currently have six tapas bars and restaurants across London, and we continue to be proud to be the ‘home of authentic Spanish food’. Our menu boasts a sensational selection of tapas, great bar snacks and traditional Spanish comfort food together with a wide range of drinks, all made from the finest fresh ingredients sourced from artisan producers all around Spain.\n\nOur guests love the theatre of open kitchens and seeing our talented chefs in action or enjoy a relaxed dinner in our sitting area or an alfresco tapas feast on our terraces.\n\nTogether with our passion for Spain and its wonderful produce, our culinary skills, warm hospitality and heartfelt desire to delight our guests who visit us from all over the world, we constantly strive to make our working environment a healthy, happy and harmonious place.", "email": null, "phone": null, "warnings_settings": {"job_location_range": true, "job_location_range_distance": 100, "job_location_range_distance_unit": "MILES"}, "force_media": [], "logjam_settings": {"show_expiry_date": false}, "public_services": ["GDPR", "NO_PASSWORD_QUICK_APPLY", "GLOBAL_TALENT_POOL", "EQUAL_EMPLOYMENT_OPPORTUNITY"], "scheme_settings": {"background_color": "#da5a33", "accent_color": "#3a3a58"}, "business_identifier": "5df24a860c0322b4ddae4a4f6fb902", "accessibility_tool_settings": null, "Cusine": [], "BrandMedia": [{"id": 722567, "is_hosted": false, "format": "IMAGE", "path": "brands/4018609/brand_background/", "status": "ACTIVE", "media_secondary": [], "type": "background_image", "uuid": "1241d01281de4809ac2db5a50e4b51cf", "file_extension": null}, {"id": 722561, "is_hosted": false, "format": "IMAGE", "path": "brands/4018609/brand_profile/", "status": "ACTIVE", "media_secondary": [], "type": "profile_image", "uuid": "a64c86152c4445ff9ba7ef910158f7c8", "file_extension": null}, {"id": 787057, "is_hosted": false, "format": "VIDEO", "path": "brands/4018609/job_background_image/", "status": "ACTIVE", "media_secondary": [{"id": 16098, "order": 1, "path": "brands/4018609/job_background_image/", "type": "THUMBNAIL", "uuid": "a242b0814031456d9463e932f00699c6"}], "type": "job_background_image", "uuid": "f2d866298bb54b459d86b7851680f63d", "file_extension": null}], "hecs": [], "Location": [{"id": 1730118, "latitude": 51.5073509, "longitude": -0.1277583, "is_primary": false, "postal_code": null, "street": null, "suite": null, "district": null, "google_place_id": "ChIJdd4hrwug2EcRmSrV3Vo6llI", "formatted_address": "London, UK", "created": "Wed, 18 Mar 2020 15:01:14