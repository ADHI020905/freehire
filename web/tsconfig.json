{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Listing `types` at all stops TS from auto-including every `@types/*`
    // package, so `node` has to be named — dropping it broke ambient `Buffer` in
    // src/lib/server/og/*.
    "types": ["node"]
  }
  // Path aliases ($lib) and includes are provided by SvelteKit's generated
  // ./.svelte-kit/tsconfig.json (run `svelte-kit sync` to (re)generate it).
}
