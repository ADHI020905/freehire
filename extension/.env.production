# Production build targets (`wxt build`): which deployment the extension talks to,
# and where its usage events go. Nothing here is a secret — all of it ships inside
# the bundle anyway. `wxt dev` runs in development mode and ignores this file,
# falling back to the localhost default in lib/auth.ts.
#
# One hire origin serves all of the product: the chat, the browser-tool relay, autofill and the
# job reads are all hire.
WXT_HIRE_ORIGIN=https://freehire.me

# Usage analytics (lib/analytics.ts): the site's own GA4 stream, so the site and the
# panel read as one funnel. The Measurement Protocol API secret only permits sending
# events to this stream, and is extractable from any published build regardless.
WXT_GA_MEASUREMENT_ID=G-6P1PZ719T0
WXT_GA_API_SECRET=OY2jYE0gTdyFeAvoNlszyw
